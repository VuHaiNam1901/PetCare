DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=
DB_NAME=petcare_db
PORT=3000
JWT_SECRET=
GEMINI_API_KEY=
CHAT_RATE_WINDOW_MS=60000
CHAT_SESSION_LIMIT=10
CHAT_IP_LIMIT=30
CHAT_RATE_MAX_KEYS=10000
CHAT_MAX_CONCURRENT=3
CHAT_METRICS=0
CHAT_PIPELINE=legacy

# Stage 1 stays disabled until schema, operations and frontend are reviewed.
# Do not copy enabled values into a real environment during code review.
PETCARE_ORDER_WORKFLOW_ENABLED=0
PETCARE_ORDER_FRONTEND_READY=0
PETCARE_ORDER_EXPIRY_ENABLED=0
# Simulator additionally requires the isolated synthetic test database guard.
PETCARE_PAYMENT_SIMULATION_ENABLED=0
PETCARE_VOUCHERS_ENABLED=0
