DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=
DB_NAME=petcare_db
PORT=3000
JWT_SECRET=
GEMINI_API_KEY=
# Danh sách Origin được phép gọi API (phân tách bằng dấu phẩy khi triển khai Railway)
FRONTEND_URL=
CORS_ORIGINS=
# Giới hạn tần suất bảo vệ xác thực, báo giá Voucher và đặt hàng
AUTH_LOGIN_RATE_WINDOW_MS=900000
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_REGISTER_RATE_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT=15
VOUCHER_QUOTE_RATE_WINDOW_MS=60000
VOUCHER_QUOTE_RATE_LIMIT=30
ORDER_CREATE_RATE_WINDOW_MS=60000
ORDER_CREATE_RATE_LIMIT=20
CHAT_RATE_WINDOW_MS=60000
CHAT_SESSION_LIMIT=10
CHAT_IP_LIMIT=30
CHAT_RATE_MAX_KEYS=10000
CHAT_MAX_CONCURRENT=3
CHAT_METRICS=0
# Bước 1–4: Orchestrator + Memory + Website Knowledge + Page/UI/State.
# Use legacy explicitly to roll back; an omitted value still defaults to legacy.
CHAT_PIPELINE=orchestrator

# Stage 1 stays disabled until schema, operations and frontend are reviewed.
# Do not copy enabled values into a real environment during code review.
PETCARE_ORDER_WORKFLOW_ENABLED=0
PETCARE_ORDER_FRONTEND_READY=0
PETCARE_ORDER_EXPIRY_ENABLED=0
# Simulator additionally requires the isolated synthetic test database guard.
PETCARE_PAYMENT_SIMULATION_ENABLED=0
PETCARE_VOUCHERS_ENABLED=0

# SePay: both integration and Live stay OFF by default.
# Enabling this alone cannot authorize test data against the application DB.
SEPAY_INTEGRATION_ENABLED=0
SEPAY_LIVE_ENABLED=0
SEPAY_ENVIRONMENT=test
SEPAY_TEST_MODE=0
SEPAY_TEST_ACCOUNT_CONFIRMED=0
SEPAY_TEST_ACCOUNT_NUMBER=
SEPAY_TEST_ACCOUNT_NAME=
SEPAY_TEST_WEBHOOK_SECRET=
# Optional Turn 2 write binding: must equal the verified isolated test DB name.
# Empty preserves read-only reconciliation; never set to petcare_db.
SEPAY_TEST_WRITE_DATABASE=
# Reserved for a separately reviewed Live deployment; keep blank during Step A.
# The tested adapter supports direct VietinBank accounts and SEVQR PCS<orderId>.
SEPAY_LIVE_ACCOUNT_CONFIRMED=0
SEPAY_LIVE_ACCOUNT_NUMBER=
SEPAY_LIVE_ACCOUNT_NAME=
SEPAY_LIVE_WEBHOOK_SECRET=
# Must exactly match DB_NAME and the actual SQL connection when Live is enabled.
SEPAY_LIVE_WRITE_DATABASE=
