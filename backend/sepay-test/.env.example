# Optional receiver-only config. Copy to backend/sepay-test/.env, never backend/.env.
SEPAY_TEST_MODE=1
SEPAY_TEST_PORT=3001
# Dedicated Test Mode HMAC key: 32-256 printable ASCII characters, no whitespace.
# Use the same key in SePay Test Mode. Do not reuse a Live key.
SEPAY_TEST_WEBHOOK_SECRET=

# Stage 2 remains OFF. Settlement additionally needs the exact test DB binding.
# For isolated verification only: also requires NODE_ENV=test, an exact generated
# PETCARE_TEST_DATABASE=DB_NAME and PETCARE_TEST_ISOLATED=1 with distinct source.
SEPAY_INTEGRATION_ENABLED=0
SEPAY_ENVIRONMENT=test
SEPAY_TEST_ACCOUNT_CONFIRMED=0
SEPAY_TEST_ACCOUNT_NUMBER=
SEPAY_TEST_ACCOUNT_NAME=
# Optional Turn 2: exact isolated DB target. Empty keeps Turn 1 read-only mode.
SEPAY_TEST_WRITE_DATABASE=
